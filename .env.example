# Server-opslag van tellingen (Supabase). Zie docs/SERVER_SYNC.md.
# Deze twee (publieke) waarden zet je in Vercel -> Project -> Settings -> Environment Variables, en lokaal in .env.local.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# Enkel voor de Vercel-functies api/central-*.ts (lezen van de oude data uit Supabase; zelfde waarden als hierboven).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon public key>
